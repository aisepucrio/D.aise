# ─── D.aise · configuração do Docker Compose ─────────────────────────────────
# Copie este arquivo para `.env` e ajuste os valores:
#
#     cp .env.example .env
#
# O `.env` fica ao lado do docker-compose.yml e é lido automaticamente pelo
# `docker compose`. Ele NÃO vai para o Git (está no .gitignore).

# ─── Segurança · OBRIGATÓRIO ─────────────────────────────────────────────────
# Chave-mestra (Fernet) usada para CIFRAR as credenciais salvas no modo "cloud".
# Sem ela o `docker compose up` falha de propósito (para você não esquecer).
#
# Gere a SUA chave (escolha uma opção):
#   • com Docker (não precisa de Python instalado):
#       docker run --rm python:3.12-slim sh -c "pip -q install cryptography && \
#         python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
#   • com Python local:
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Cole o resultado aqui. IMPORTANTE: mantenha a MESMA chave entre reinícios,
# senão as credenciais já cifradas ficam ilegíveis.
DAISE_SECRET_KEY=

# ─── Usuário admin inicial ───────────────────────────────────────────────────
# Criado no primeiro boot. Use para o primeiro login em http://localhost:3000/login
DAISE_BOOTSTRAP_EMAIL=admin@daise.local
DAISE_BOOTSTRAP_PASSWORD=changeme

# ─── LLM ─────────────────────────────────────────────────────────────────────
# true  = chama o provedor de verdade (Gemini/Ollama) — configure a chave na UI
# false = usa README de mockup (sem custo, ótimo para testar o fluxo)
USE_LLM=true
DEBUG=false

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Usados pelo serviço `db` e montados na DATABASE_URL do backend.
POSTGRES_USER=daise
POSTGRES_PASSWORD=daise
POSTGRES_DB=daise

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL da API acessível pelo NAVEGADOR (o fetch roda no host, não dentro da rede
# do compose). Mude apenas se expor em outra máquina/porta.
NEXT_PUBLIC_API_URL=http://localhost:8765
